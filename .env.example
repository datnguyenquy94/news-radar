# GitHub token for API access + issue creation. Named GH_TOKEN (not GITHUB_TOKEN):
# GitHub Actions reserves the GITHUB_ prefix, so the workflows map the built-in
# token via `GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}`. Locally, use a PAT.
GH_TOKEN=ghp_xxxxx

# Languages to generate (default: bilingual). Unset = vi,en
# DIGEST_LANGS=vi,en    # both (default)
# DIGEST_LANGS=en       # English only
# DIGEST_LANGS=vi       # Vietnamese only

# LLM provider for local scripts
# LLM_PROVIDER=anthropic

# Max concurrent LLM requests (positive integer, default: 5)
# LLM_CONCURRENCY=5

# Per-request LLM timeout in ms (positive integer, default: 600000 = 10 min).
# A request that exceeds it is retried like a 429, after a >= 60 s wait.
# LLM_TIMEOUT_MS=600000

# Logging (pino). Everything is written to stderr; stdout stays a data channel.
# LOG_LEVEL: trace | debug | info (default) | warn | error | fatal | silent
# LOG_PRETTY: 1 = human-readable, 0 = JSON. Unset = pretty on a TTY, JSON in CI.
# LOG_LEVEL=info
# LOG_PRETTY=1
ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Macro dashboard (fin-macro report). FRED = Federal Reserve Economic Data.
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html. Optional:
# when unset, FRED is fetched via the keyless CSV endpoint. FINRA needs no key.
FRED_API_KEY=
