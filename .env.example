# Languages to generate (default: bilingual). Unset = zh,en
# DIGEST_LANGS=zh,en    # both (default)
# DIGEST_LANGS=en       # English only
# DIGEST_LANGS=zh       # Chinese only

# LLM provider for local scripts
# LLM_PROVIDER=anthropic

# Max concurrent LLM requests (positive integer, default: 5)
# LLM_CONCURRENCY=5
ANTHROPIC_API_KEY=sk-ant-xxxxx
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Macro dashboard (fin-macro report). FRED = Federal Reserve Economic Data.
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html. Optional:
# when unset, FRED is fetched via the keyless CSV endpoint. FINRA needs no key.
FRED_API_KEY=
